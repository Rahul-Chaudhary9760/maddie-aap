# Maddie App — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# Expo variables MUST be prefixed with EXPO_PUBLIC_ to be accessible in the app.

# API base URL for the maddie backend
# Android Emulator: http://10.0.2.2:8000/api/v1
# iOS Simulator: http://localhost:8000/api/v1
# Physical Device (dev): http://<your-machine-IP>:8000/api/v1
# Production: https://your-api.example.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
